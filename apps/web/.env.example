# Public build settings; Vite exposes every VITE_ variable to the browser.
# Who answers in the thread: the scripted stand-in, or a model behind the gateway.
VITE_AGENT=lab
# The gateway's origin; leave empty when the Worker serves the site and the API together.
VITE_GATEWAY_URL=
# How visitors sign in: none for local evaluation, workos for AuthKit.
VITE_AUTH=none
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback
