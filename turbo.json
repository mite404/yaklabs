{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  // Unknown files are global inputs until their workspace dependencies are modeled.
  "globalDependencies": [
    "**",
    "!.git/**",
    "!.turbo/**",
    "!.amp/**",
    "!.artifacts/**",
    "!.fallow/**",
    "!**/node_modules/**",
    ".amp/services.yaml",
    "!apps/gateway/**",
    "!apps/storybook/**",
    "!apps/web/**",
    "!packages/catalog/**",
    "!packages/config/**",
    "!packages/runtime/**",
    "!packages/ui/**",
    "!tools/verify-ui-drift/**",
    // The catalog's token tests read this web asset, outside the package graph.
    "apps/web/public/chrome/painting.json"
  ],
  "globalEnv": ["CI", "NODE_ENV", "VITE_*", "WEB_BUILD_DIRECTORY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    // The Worker's dry run bundles the web build as its static assets (ADR-086).
    "gateway#build": {
      "dependsOn": ["web#build"],
      "outputs": ["dist/**"]
    },
    // The runtime ships source and takes only the gateway's types, so its build waits on
    // nothing; inheriting ^build would wait on gateway#build, which waits on web#build, which
    // waits on the runtime.
    "@yaklabs/runtime#build": {
      "dependsOn": []
    },
    "build-storybook": {
      "dependsOn": ["^typecheck"],
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "web#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".react-router/types/**"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:unit": {
      "dependsOn": ["^typecheck"]
    },
    "test:stories": {
      "dependsOn": ["^typecheck"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
